{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "careerflow-watch",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true },
  "triggers": { "crons": ["17 */6 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "careerflow-watch",
      "database_id": "4ab27a5d-5480-40e2-8945-d1030e228412",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://mahirun019-dev.github.io"
  }
}
