{
  "name": "yami-local-google-account",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:local": "wrangler d1 migrations apply ACCOUNT_DB --local",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
