  },
  "dependencies": {
    "openid-client": "^6.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.0.0",
    "jose": "^6.1.0",
    "miniflare": "5.20261023.3-beta",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "4.156.0"
  }
}
